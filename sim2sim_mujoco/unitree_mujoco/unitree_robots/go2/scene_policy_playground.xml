<mujoco model="Go2 stairs and raised-ground playground">
  <include file="go2.xml"/>
  <statistic center="5.5 0 0.25" extent="8"/>
  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
    <rgba haze="0.18 0.24 0.30 1"/>
    <global azimuth="135" elevation="-30"/>
    <map znear="0.01" zfar="8"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.48 0.62" rgb2="0.06 0.10 0.16"
      width="512" height="3072"/>
    <texture type="2d" name="ground_check" builtin="checker" rgb1="0.27 0.31 0.35"
      rgb2="0.21 0.25 0.29" width="512" height="512"/>
    <material name="ground" texture="ground_check" texuniform="true" texrepeat="2 2"/>
    <material name="pad_blue" rgba="0.20 0.40 0.53 1"/>
    <material name="stairs_up" rgba="0.34 0.61 0.50 1"/>
    <material name="top_pad" rgba="0.32 0.52 0.64 1"/>
    <material name="stairs_down" rgba="0.47 0.48 0.70 1"/>
    <material name="bump_pad" rgba="0.46 0.36 0.25 1"/>
    <material name="bump_low" rgba="0.76 0.56 0.28 1"/>
    <material name="bump_high" rgba="0.82 0.40 0.23 1"/>
    <material name="ramp" rgba="0.26 0.57 0.60 1"/>
    <material name="rubble" rgba="0.62 0.52 0.39 1"/>
    <material name="narrow_stairs" rgba="0.57 0.44 0.62 1"/>
  </asset>
  <worldbody>
    <light pos="1 -2 6" dir="0.3 0 -1" directional="true"/>
    <light pos="9 3 5" dir="-0.2 -0.1 -1" directional="true" diffuse="0.45 0.45 0.45"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="ground" friction="0.6 0.02 0.01"/>

    <!-- Visual markings float 3 mm above the floor to avoid coplanar z-fighting.
         Group 2 is excluded from height rays and contact generation. -->
    <geom name="start_pad_marking" type="box" pos="0 0 0.002" size="1.4 2 0.001"
      material="pad_blue" contype="0" conaffinity="0" group="2"/>
    <geom name="transition_marking" type="box" pos="7.3 0 0.002" size="0.7 2 0.001"
      material="pad_blue" contype="0" conaffinity="0" group="2"/>
    <geom name="finish_marking" type="box" pos="13 0 0.002" size="1.2 2 0.001"
      material="pad_blue" contype="0" conaffinity="0" group="2"/>

    <!-- 5 cm risers, 30 cm treads, 4 m wide. -->
    <geom name="up_1" type="box" pos="1.65 0 0.025" size="0.15 2 0.025" material="stairs_up"/>
    <geom name="up_2" type="box" pos="1.95 0 0.05" size="0.15 2 0.05" material="stairs_up"/>
    <geom name="up_3" type="box" pos="2.25 0 0.075" size="0.15 2 0.075" material="stairs_up"/>
    <geom name="up_4" type="box" pos="2.55 0 0.10" size="0.15 2 0.10" material="stairs_up"/>
    <geom name="up_5" type="box" pos="2.85 0 0.125" size="0.15 2 0.125" material="stairs_up"/>
    <geom name="up_6" type="box" pos="3.15 0 0.15" size="0.15 2 0.15" material="stairs_up"/>
    <geom name="platform" type="box" pos="4.2 0 0.15" size="0.9 2 0.15" material="top_pad"/>
    <geom name="down_5" type="box" pos="5.25 0 0.125" size="0.15 2 0.125" material="stairs_down"/>
    <geom name="down_4" type="box" pos="5.55 0 0.10" size="0.15 2 0.10" material="stairs_down"/>
    <geom name="down_3" type="box" pos="5.85 0 0.075" size="0.15 2 0.075" material="stairs_down"/>
    <geom name="down_2" type="box" pos="6.15 0 0.05" size="0.15 2 0.05" material="stairs_down"/>
    <geom name="down_1" type="box" pos="6.45 0 0.025" size="0.15 2 0.025" material="stairs_down"/>

    <!-- Raised flat zone: 1 cm pad carrying low ridges and scattered 2--4 cm blocks. -->
    <geom name="raised_ground" type="box" pos="10 0 0.005" size="2 2 0.005" material="bump_pad"/>
    <geom name="bump_ridge_1" type="box" pos="8.5 0 0.02" size="0.18 1.9 0.01" material="bump_low"/>
    <geom name="bump_ridge_2" type="box" pos="9.3 0 0.025" size="0.22 1.9 0.015" material="bump_low"/>
    <geom name="bump_ridge_3" type="box" pos="11.2 0 0.025" size="0.18 1.9 0.015" material="bump_low"/>
    <geom name="bump_1" type="box" pos="9.9 -0.6 0.025" size="0.28 0.3 0.015" material="bump_high"/>
    <geom name="bump_2" type="box" pos="10.15 0.6 0.03" size="0.30 0.3 0.02" material="bump_high"/>
    <geom name="bump_3" type="box" pos="10.6 -1.2 0.02" size="0.3 0.3 0.01" material="bump_low"/>
    <geom name="bump_4" type="box" pos="10.7 1.2 0.025" size="0.26 0.35 0.015" material="bump_low"/>

    <!-- Parallel lane at y=+4.5: about 5.7 degree ascent/descent and low rubble. -->
    <geom name="ramp_start_marking" type="box" pos="0 4.5 0.002" size="1.4 1.2 0.001"
      material="ramp" contype="0" conaffinity="0" group="2"/>
    <geom name="ramp_up" type="box" pos="2.5 4.5 0.08" size="1 1.2 0.02" euler="0 -0.1 0" material="ramp"/>
    <geom name="ramp_platform" type="box" pos="4.5 4.5 0.1" size="1 1.2 0.1" material="ramp"/>
    <geom name="ramp_down" type="box" pos="6.5 4.5 0.08" size="1 1.2 0.02" euler="0 0.1 0" material="ramp"/>
    <geom name="rubble_1" type="box" pos="8.4 3.85 0.01" size="0.22 0.22 0.01" euler="0 0 0.15" material="rubble"/>
    <geom name="rubble_2" type="box" pos="8.6 4.5 0.015" size="0.22 0.22 0.015" euler="0 0 -0.2" material="rubble"/>
    <geom name="rubble_3" type="box" pos="8.8 5.15 0.02" size="0.22 0.22 0.02" material="rubble"/>
    <geom name="rubble_4" type="box" pos="9.2 3.85 0.02" size="0.22 0.22 0.02" material="rubble"/>
    <geom name="rubble_5" type="box" pos="9.4 4.5 0.01" size="0.22 0.22 0.01" euler="0 0 0.2" material="rubble"/>
    <geom name="rubble_6" type="box" pos="9.6 5.15 0.015" size="0.22 0.22 0.015" material="rubble"/>
    <geom name="rubble_7" type="box" pos="10 3.85 0.015" size="0.22 0.22 0.015" material="rubble"/>
    <geom name="rubble_8" type="box" pos="10.2 4.5 0.02" size="0.22 0.22 0.02" euler="0 0 -0.15" material="rubble"/>
    <geom name="rubble_9" type="box" pos="10.4 5.15 0.01" size="0.22 0.22 0.01" material="rubble"/>
    <geom name="rubble_10" type="box" pos="10.8 3.85 0.01" size="0.22 0.22 0.01" material="rubble"/>
    <geom name="rubble_11" type="box" pos="11 4.5 0.015" size="0.22 0.22 0.015" euler="0 0 0.15" material="rubble"/>
    <geom name="rubble_12" type="box" pos="11.2 5.15 0.02" size="0.22 0.22 0.02" material="rubble"/>

    <!-- Parallel lane at y=-4.5: 3 cm stairs with a 1.2 m wide walkway. -->
    <geom name="narrow_start_marking" type="box" pos="0 -4.5 0.002" size="1.4 0.6 0.001"
      material="narrow_stairs" contype="0" conaffinity="0" group="2"/>
    <geom name="narrow_up_1" type="box" pos="1.65 -4.5 0.015" size="0.15 0.6 0.015" material="narrow_stairs"/>
    <geom name="narrow_up_2" type="box" pos="1.95 -4.5 0.03" size="0.15 0.6 0.03" material="narrow_stairs"/>
    <geom name="narrow_up_3" type="box" pos="2.25 -4.5 0.045" size="0.15 0.6 0.045" material="narrow_stairs"/>
    <geom name="narrow_up_4" type="box" pos="2.55 -4.5 0.06" size="0.15 0.6 0.06" material="narrow_stairs"/>
    <geom name="narrow_platform" type="box" pos="3.3 -4.5 0.06" size="0.6 0.6 0.06" material="narrow_stairs"/>
    <geom name="narrow_down_3" type="box" pos="4.05 -4.5 0.045" size="0.15 0.6 0.045" material="narrow_stairs"/>
    <geom name="narrow_down_2" type="box" pos="4.35 -4.5 0.03" size="0.15 0.6 0.03" material="narrow_stairs"/>
    <geom name="narrow_down_1" type="box" pos="4.65 -4.5 0.015" size="0.15 0.6 0.015" material="narrow_stairs"/>
  </worldbody>
</mujoco>
